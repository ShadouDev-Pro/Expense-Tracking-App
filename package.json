{
  "name": "api-gastos",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n BACKEND,FRONTEND -c blue,magenta \"npm run start -w backend\" \"npm run dev -w frontend\"",
    "start:backend": "npm run start -w backend",
    "start:frontend": "npm run dev -w frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
